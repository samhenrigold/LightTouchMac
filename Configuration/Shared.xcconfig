// Shared by Debug and Release. Keep the app and packaged native libraries on
// the same minimum macOS version.
MACOSX_DEPLOYMENT_TARGET = 14.4

// The pinned qemu-ios checkout and its development build (build-support/sources.json: "path" and
// "build_dir"). A Debug helper loads libqemu-arm.dylib from there (its rpath) unless LTM_QEMU_DYLIB names
// another; a release loads only the one Archive copies into Contents/Frameworks.
QEMU_IOS_DIR = $(HOME)/Developer/qemu-ios
QEMU_BUILD_DIR = $(QEMU_IOS_DIR)/build-w1-native

// scripts/vendor's directory for the current pins: what Archive copies into the app (Frameworks, the tools in
// MacOS, Resources/Guest, Device and licenses) and the libimobiledevice headers and libraries the services helper
// links. The services helper's first phase (scripts/vendor-check) points the gitignored build/vendor at the current
// pins' directory, or fails the build saying to run scripts/vendor. Local.xcconfig (gitignored) may set VENDOR_DIR
// or anything else here; the check holds an overridden VENDOR_DIR to the current pins too.
VENDOR_DIR = $(SRCROOT)/build/vendor

// The build number (CFBundleVersion) is the commit count, stamped into the app's Info.plist by its
// "Build Number" phase at every build; this is only what the helpers' embedded Info.plists carry.
CURRENT_PROJECT_VERSION = 1

// The device helper under the App Sandbox: YES signs LightTouchDevice with LightTouchDevice-Sandbox.entitlements
// (-Sandbox-Debug in Debug) and the app with LightTouchMac-Sandbox.entitlements (the helper's app group). Nothing else
// reads it: at run time the app, firmwarekit and the harness look at the helper's own signature (HostRuntime
// HelperSandbox). On in Debug and Release; for debugging without it, LTM_HELPER_SANDBOX = NO in Local.xcconfig, or
// `xcodebuild … LTM_HELPER_SANDBOX=NO` (`LTM_HELPER_SANDBOX=NO scripts/ship` or `sessions`).
LTM_HELPER_SANDBOX = YES
LTM_HELPER_ENTITLEMENTS_NO = Configuration/LightTouchDevice.entitlements
LTM_HELPER_ENTITLEMENTS_YES = Configuration/LightTouchDevice-Sandbox.entitlements
LTM_HELPER_DEBUG_ENTITLEMENTS_NO = Configuration/LightTouchDevice-Debug.entitlements
LTM_HELPER_DEBUG_ENTITLEMENTS_YES = Configuration/LightTouchDevice-Sandbox-Debug.entitlements
LTM_APP_ENTITLEMENTS_NO =
LTM_APP_ENTITLEMENTS_YES = Configuration/LightTouchMac-Sandbox.entitlements

LD_RUNPATH_SEARCH_PATHS = $(inherited) "@executable_path/../Frameworks"
LD_RUNPATH_SEARCH_PATHS[config=Debug] = $(inherited) "@executable_path/../Frameworks" "$(QEMU_BUILD_DIR)" "$(VENDOR_DIR)/Frameworks"

// The project's settings: every target's base. The targets' own are in App, Device, Services and Tool.xcconfig; the
// project file sets nothing. A [config=…] line is where Debug and Release differ.
SDKROOT = macosx
SWIFT_VERSION = 6.0
DEVELOPMENT_TEAM = SM75355Y6R
PRODUCT_NAME = $(TARGET_NAME)
GENERATE_INFOPLIST_FILE = YES
ENABLE_HARDENED_RUNTIME = YES
ENABLE_USER_SCRIPT_SANDBOXING = YES
LOCALIZATION_PREFERS_STRING_CATALOGS = NO
ASSETCATALOG_COMPILER_GENERATE_SWIFT_ASSET_SYMBOL_EXTENSIONS = YES

// Debug builds sign with the development team's automatic identity; Release (the archive) with Developer ID.
CODE_SIGN_STYLE = Automatic
CODE_SIGN_STYLE[config=Release] = Manual
CODE_SIGN_IDENTITY[config=Release] = Developer ID Application

COPY_PHASE_STRIP = NO
DEBUG_INFORMATION_FORMAT = dwarf-with-dsym
DEBUG_INFORMATION_FORMAT[config=Debug] = dwarf
ENABLE_NS_ASSERTIONS[config=Release] = NO
ENABLE_TESTABILITY[config=Debug] = YES
GCC_DYNAMIC_NO_PIC[config=Debug] = NO
GCC_OPTIMIZATION_LEVEL[config=Debug] = 0
GCC_PREPROCESSOR_DEFINITIONS[config=Debug] = DEBUG=1 $(inherited)
MTL_ENABLE_DEBUG_INFO = NO
MTL_ENABLE_DEBUG_INFO[config=Debug] = INCLUDE_SOURCE
MTL_FAST_MATH = YES
ONLY_ACTIVE_ARCH[config=Debug] = YES
SWIFT_ACTIVE_COMPILATION_CONDITIONS[config=Debug] = DEBUG $(inherited)
SWIFT_COMPILATION_MODE[config=Release] = wholemodule
SWIFT_OPTIMIZATION_LEVEL[config=Debug] = -Onone

ALWAYS_SEARCH_USER_PATHS = NO
CLANG_ANALYZER_NONNULL = YES
CLANG_ANALYZER_NUMBER_OBJECT_CONVERSION = YES_AGGRESSIVE
CLANG_CXX_LANGUAGE_STANDARD = gnu++20
CLANG_ENABLE_MODULES = YES
CLANG_ENABLE_OBJC_ARC = YES
CLANG_ENABLE_OBJC_WEAK = YES
CLANG_WARN_BLOCK_CAPTURE_AUTORELEASING = YES
CLANG_WARN_BOOL_CONVERSION = YES
CLANG_WARN_COMMA = YES
CLANG_WARN_CONSTANT_CONVERSION = YES
CLANG_WARN_DEPRECATED_OBJC_IMPLEMENTATIONS = YES
CLANG_WARN_DIRECT_OBJC_ISA_USAGE = YES_ERROR
CLANG_WARN_DOCUMENTATION_COMMENTS = YES
CLANG_WARN_EMPTY_BODY = YES
CLANG_WARN_ENUM_CONVERSION = YES
CLANG_WARN_INFINITE_RECURSION = YES
CLANG_WARN_INT_CONVERSION = YES
CLANG_WARN_NON_LITERAL_NULL_CONVERSION = YES
CLANG_WARN_OBJC_IMPLICIT_RETAIN_SELF = YES
CLANG_WARN_OBJC_LITERAL_CONVERSION = YES
CLANG_WARN_OBJC_ROOT_CLASS = YES_ERROR
CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER = YES
CLANG_WARN_RANGE_LOOP_ANALYSIS = YES
CLANG_WARN_STRICT_PROTOTYPES = YES
CLANG_WARN_SUSPICIOUS_MOVE = YES
CLANG_WARN_UNGUARDED_AVAILABILITY = YES_AGGRESSIVE
CLANG_WARN_UNREACHABLE_CODE = YES
CLANG_WARN__DUPLICATE_METHOD_MATCH = YES
ENABLE_STRICT_OBJC_MSGSEND = YES
GCC_C_LANGUAGE_STANDARD = gnu17
GCC_NO_COMMON_BLOCKS = YES
GCC_WARN_64_TO_32_BIT_CONVERSION = YES
GCC_WARN_ABOUT_RETURN_TYPE = YES_ERROR
GCC_WARN_UNDECLARED_SELECTOR = YES
GCC_WARN_UNINITIALIZED_AUTOS = YES_AGGRESSIVE
GCC_WARN_UNUSED_FUNCTION = YES
GCC_WARN_UNUSED_VARIABLE = YES

#include? "Local.xcconfig"
