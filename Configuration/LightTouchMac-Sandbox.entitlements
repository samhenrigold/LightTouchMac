<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- The app with sandboxed helpers (LTM_HELPER_SANDBOX = YES): the device helper's app group and the services' (the
     usbmuxd sockets), so the app makes the groups' containers and the sockets in them as its own (HostRuntime
     HelperSandbox, ServicesSandbox). Location as ENABLE_RESOURCE_ACCESS_LOCATION
     gives the app without this file. The app itself is not sandboxed. -->
<dict>
    <key>com.apple.security.personal-information.location</key>
    <true/>
    <key>com.apple.security.application-groups</key>
    <array>
        <string>SM75355Y6R.ltm</string>
        <string>SM75355Y6R.ltm.services</string>
    </array>
</dict>
</plist>
