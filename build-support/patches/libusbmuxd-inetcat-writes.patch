+/* devfd is non-blocking (libimobiledevice-glue's socket_connect_unix sets O_NONBLOCK), so a write can take part of
+ * the buffer or none of it while usbmuxd waits for the device's TCP window. What it doesn't take stays pending for the
+ * next select: dropping it loses those bytes from the middle of the stream, and waiting here for it would stop the
+ * other direction, which the device may have to send before it reads more. */
+static int write_pending(int fd, const uint8_t* buf, size_t len, size_t* done)
+{
+    while (*done < len) {
+        ssize_t n = write(fd, buf + *done, len - *done);
+        if (n > 0) {
+            *done += (size_t)n;
+        } else if (n < 0 && errno == EINTR) {
+            continue;
+        } else if (n < 0 && (errno == EAGAIN || errno == EWOULDBLOCK)) {
+            return 0;
+        } else {
+            return -1;
+        }
+    }
+    return 0;
+}
